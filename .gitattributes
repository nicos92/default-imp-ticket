# Normalización automática de saltos de línea para archivos de texto
* text=auto eol=lf

# Forzar LF explícitamente en código y configuración
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
*.md text eol=lf

# Archivos binarios (Git no debe tocar sus saltos de línea)
*.png binary
*.jpg binary
*.ico binary
